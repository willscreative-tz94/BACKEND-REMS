APP_NAME="willsrems"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8002
FRONTEND_URL=http://localhost:4300

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rems
DB_USERNAME=william
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="architectwills@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── REMS ─────────────────────────────────────────────────────────────
# Multitenancy: set to e.g. rems.app to resolve agencies from subdomains.
APP_POWERED_BY=willscreativedesign
TENANCY_MODE=multitenant
TENANCY_ENTERPRISE_ORGANIZATION=
TENANCY_BASE_DOMAIN=
# Email every in-app notification (uses MAIL_*). Off by default.
REMS_NOTIFICATION_MAIL=false

# One-time email code on every sign-in and new registration.
REMS_OTP_ENABLED=true
REMS_OTP_TTL=10
REMS_OTP_MAX_ATTEMPTS=5
REMS_OTP_RESEND_SECONDS=60
# Also write codes to storage/logs/laravel.log (ignored in production) — for demo accounts that can't receive mail.
REMS_OTP_LOG_CODES=false

# Online payments: simulated | mpesa
PAYMENT_DRIVER=simulated
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
